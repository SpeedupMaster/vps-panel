# Panel (keep it private: restrict by IP or put it behind your own proxy)
panel.example.com {
	encode zstd gzip
	# Agents use gRPC over HTTP/2 on the same port; h2c keeps it end-to-end HTTP/2.
	reverse_proxy h2c://127.0.0.1:8080 {
		flush_interval -1
		transport http {
			read_timeout 0
		}
	}
}

# Subscription domain: when sub_url is set to this domain in the panel,
# the panel automatically restricts this host to subscription links only
# (/<token> and legacy /s/<token>) and returns 404 for the admin UI and API.
sub.example.com {
	# Defense-in-depth: block gRPC (AgentHub) and admin API at the edge proxy as well.
	@blocked path /vpspanel.AgentHub/* /api /api/*
	respond @blocked 404
	reverse_proxy h2c://127.0.0.1:8080
}
