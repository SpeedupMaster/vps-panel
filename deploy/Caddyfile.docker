# Panel (keep it private: restrict by IP or put it behind your own proxy)
{$PANEL_DOMAIN:panel.example.com} {
	# Agents use gRPC over HTTP/2 on the same port; h2c keeps it end-to-end HTTP/2.
	# Scope unbuffered streaming & infinite read timeout strictly to gRPC, SSE, and WebSocket endpoints.
	@stream path /vpspanel.AgentHub/* /api/events /api/tasks/*/stream /api/servers/*/shell
	handle @stream {
		reverse_proxy h2c://panel:8080 {
			flush_interval -1
			transport http {
				read_timeout 0
			}
		}
	}
	handle {
		encode zstd gzip
		reverse_proxy h2c://panel:8080 {
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}
}

# Optional separate subscription domain.
# Uncomment and replace sub.example.com, then set "订阅域名" to https://sub.example.com in the panel.
# The panel automatically restricts this host to subscription links (/<token> and legacy /s/<token>)
# and returns 404 for the admin UI and API.
# sub.example.com {
# 	# Defense-in-depth: block gRPC (AgentHub) and admin API at the edge proxy as well.
# 	@blocked path /vpspanel.AgentHub/* /api /api/*
# 	respond @blocked 404
# 	reverse_proxy h2c://panel:8080
# }
