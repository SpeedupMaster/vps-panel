# 面板域名（用于 deploy/docker-compose.yml 中的 Caddy 自动申请 HTTPS 证书）
# 如只需纯 HTTP 调试或前置已有反代终止 TLS，可写 http://panel.example.com 或 :80
PANEL_DOMAIN=panel.example.com

# 面板公网地址（写入面板设置，供生成 Agent 安装命令；留空则可在面板「设置」页修改）
VPSPANEL_URL=https://panel.example.com

# 首次启动时的管理员用户名与密码（密码留空会自动生成随机密码并打印到日志）
VPSPANEL_ADMIN=admin
# VPSPANEL_PASSWORD=

# 仅使用 docker-compose.panel.yml 时生效的宿主机端口映射（默认仅绑定本机 127.0.0.1:8080，避免绕过反代直连）
# 如确需对外网直接暴露，可显式设为 8080（不推荐，请优先前置 HTTPS 反向代理）
# VPSPANEL_PORT=127.0.0.1:8080

# 受信任的反向代理 IP/CIDR（逗号分隔），用于安全解析 X-Forwarded-For / X-Real-IP，防止客户端伪造来源 IP
# - docker-compose.panel.yml 默认仅信任 127.0.0.1,::1；若宿主机反代通过 Docker 网桥转发到容器，
#   或反代位于其他服务器/子网，请仅填写实际反代源 IP/CIDR（如 172.17.0.1/32 或具体反代网段），勿盲目信任宽泛网段
# - docker-compose.yml（内置 Caddy 且面板仅 expose 8080）默认信任 Docker 私有网段，也可按实际子网进一步收窄
# VPSPANEL_TRUSTED_PROXIES=127.0.0.1,::1

# 可选：自定义镜像地址（默认使用 GHCR 官方镜像）
# VPSPANEL_IMAGE=ghcr.io/speedupmaster/vps-panel:latest

# 时区
TZ=Asia/Shanghai
