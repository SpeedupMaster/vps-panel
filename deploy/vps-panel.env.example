# copy to /etc/vps-panel.env
VPSPANEL_URL=https://panel.example.com
VPSPANEL_ADMIN=admin
# VPSPANEL_PASSWORD=     # empty: a random password is printed to the journal on first start
# Bundled agent binaries registered and served directly from this dir without duplicating into the data dir (built by `make agent`)
VPSPANEL_AGENT_DIR=/opt/vps-panel/agent
# Comma-separated trusted reverse proxy IPs/CIDRs for X-Forwarded-For / X-Real-IP.
# Defaults to 127.0.0.1,::1 (sufficient when Caddy/Nginx runs on the same host).
# If your reverse proxy runs on another host/subnet, list only its exact IP or narrow CIDR.
# VPSPANEL_TRUSTED_PROXIES=127.0.0.1,::1
