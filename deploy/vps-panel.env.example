# copy to /etc/vps-panel.env
VPSPANEL_URL=https://panel.example.com
VPSPANEL_ADMIN=admin
# VPSPANEL_PASSWORD=     # empty: a random password is printed to the journal on first start
# Agent binaries copied into the data dir on first start (built by `make agent`)
VPSPANEL_AGENT_DIR=/opt/vps-panel/agent
